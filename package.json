    "config",
    "configuration"
  ],
  "author": "Arnout Kazemier",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/3rd-Eden/cli-storage/issues"
  },
  "homepage": "https://github.com/3rd-Eden/cli-storage",
  "dependencies": {
    "env-paths": "^4.0.0",
    "proper-lockfile": "^4.1.2",
    "write-file-atomic": "^7.0.0"
