  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/3rd-Eden/cli-storage.git"
  },
  "keywords": [
    "cli",
    "storage",
    "data",
    "dot",
